# Optional. Until the custom domain is connected, let Vercel supply its real URL.
# SITE_URL=https://enamplify.com
# INDEX_SITE=true

# Default is an honest email composer; no backend credentials are required.
# Enable direct delivery only after every setting below is configured and tested.
# ENQUIRY_MODE=server
# RESEND_API_KEY=
# CONTACT_FROM=Enamplify <enquiries@your-verified-domain.example>
# CONTACT_TO=
# CONTACT_ALLOWED_ORIGIN=https://your-actual-production-domain.example
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Discovery flow (/discover/). With RESEND_API_KEY, CONTACT_FROM and CONTACT_TO set, a visitor's
# answers are emailed once they leave their details; ENQUIRY_MODE is not needed for this.
# Optional funnel dashboard on the VPS (server/discovery): set both of these as well.
# DISCOVERY_UPSTREAM=
# DISCOVERY_KEY=

# Kit (newsletter and the Enamplify Me waitlist). The waitlist form on /me/ only confirms a
# signup when KIT_API_KEY and KIT_ME_WAITLIST_TAG_ID are both set.
# KIT_API_KEY=
# KIT_FORM_ID=
# KIT_TAG_ID=
# KIT_ME_WAITLIST_TAG_ID=
# KIT_ME_WAITLIST_FORM_ID=
