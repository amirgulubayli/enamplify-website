# Optional. Until the custom domain is connected, let Vercel supply its real URL.
# SITE_URL=https://enamplify.com
# INDEX_SITE=true

# Default is an honest email composer; no backend credentials are required.
# Enable direct delivery only after every setting below is configured and tested.
# ENQUIRY_MODE=server
# RESEND_API_KEY=
# CONTACT_FROM=Enamplify <enquiries@your-verified-domain.example>
# CONTACT_TO=
# CONTACT_ALLOWED_ORIGIN=https://your-actual-production-domain.example
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
